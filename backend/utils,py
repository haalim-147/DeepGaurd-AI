ALLOWED_IMAGE_TYPES=[
    "image/jpeg",
    "image/png",
    "image/webp"
]
ALLOWED_VIDEO_TYPES=[
    "video/mp4",
    "video/avi",
    "video/mov",
]
ALLOWED_AUDIO_TYPES=[
    "audio/mp3",
    "audio/wav",
    "audio/mpeg"
]

def get_file_type(file_type):
    if file_type in ALLOWED_IMAGE_TYPES:
        return "image"
    elif file_type in ALLOWED_VIDEO_TYPES:
        return "video"
    elif file_type in ALLOWED_AUDIO_TYPES:
        return "audio"
    else:
        return None